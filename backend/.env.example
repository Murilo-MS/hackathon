# Copie para .env e ajuste. O .env NUNCA vai para o Git.
PORT=8080
JWT_SECRET=troque-por-um-segredo-aleatorio-bem-grande
JWT_EXPIRES_IN=1h

# Banco local (Postgres do docker compose publicado em 127.0.0.1:5432)
DATABASE_URL=postgresql://hackathon_user:hackathon_password@127.0.0.1:5432/leilao_db

# Dentro do Docker, o host do banco é o nome do serviço: db
# DATABASE_URL=postgresql://hackathon_user:hackathon_password@db:5432/leilao_db
